APP_NAME=nfse-backend
APP_VERSION=0.1.0
ENVIRONMENT=local

NFSE_AMBIENTE=producao
NFSE_VERIFY_SSL=true

DATABASE_URL=sqlite:///./data/nfse_backend.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=300

STORAGE_BACKEND=local
STORAGE_ROOT=storage
STORAGE_BUCKET=nfse

WORKER_DRY_RUN=false
WORKER_DRY_RUN_SLEEP=0.2
WORKER_REAL_MAX_LIMITE=1000
WORKER_REAL_MAX_PAUSA=0
WORKER_CONSULTA_LOTE_TAMANHO=1000
WORKER_TEMP_DIR=data/tmp_worker
API_WORKER_ENABLED=true
EMBEDDED_SCHEDULER_ENABLED=true
API_WORKER_SLEEP=0.2
API_WORKER_CONCURRENCY=1

CONSULTAS_SCHEDULER_SLEEP=1
CONSULTAS_DEFAULT_LIMITE=1000
CONSULTAS_DEFAULT_PAUSA=0
NSU_LOOKBACK_NORMAL=50
NSU_LOOKBACK_RECONCILIACAO=1000
NSU_RECONCILIACAO_HORA_INICIO=19
NSU_RECONCILIACAO_HORA_FIM=5
NSU_RECONCILIACAO_TIMEZONE=America/Sao_Paulo
NSU_MAX_VAZIOS_CONSECUTIVOS=5
NOTAS_RECEBIDAS_DIA_CORTE_MES_ANTERIOR=3
DOWNLOAD_LOTE_MAX_NOTAS=10000
DOWNLOAD_STORAGE_WORKERS=16
DOWNLOAD_TEMP_MAX_AGE_HOURS=24
CERTIFICADO_UPLOAD_MAX_BYTES=5242880
DANFSE_LIBRARY_ROOT=backend/danfse
DANFSE_PHP_BINARY=php
DANFSE_XML_MAX_BYTES=5242880
DANFSE_TIMEOUT_SECONDS=60

INVERTEXTO_ENABLED=false
INVERTEXTO_TOKEN=
INVERTEXTO_RPM=30
INVERTEXTO_DELAY_SECONDS=0.6
INVERTEXTO_CACHE_DAYS=30

# Base local indexada dos Dados Abertos de CNPJ da Receita Federal.
# O arquivo e gerado pelo importador e nao deve ser versionado no Git.
CNPJ_RECEITA_DB_PATH=data/cnpj_receita.sqlite3
CNPJ_RECEITA_CACHE_DAYS=30
# Conexao administrativa usada somente pelos scripts de auditoria/RLS.
# Nunca exponha esta URL no frontend.
SUPABASE_DATABASE_URL=
# Usada somente pelo sincronizador local; nao e necessaria no frontend.
ONLINE_DATABASE_URL=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SECRETS_KEY=

# Chave reservada a endpoints internos servidor-servidor, como POST /auth/usuarios.
# Nunca exponha esta chave no frontend. Os endpoints do portal usam JWT Bearer.
# Em producao, gere um valor aleatorio forte, por exemplo:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Chave usada para assinar o token de login dos clientes (JWT). Obrigatoria
# para o /auth/login funcionar. Gere com:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
LOG_LEVEL=INFO
ALERT_WEBHOOK_URL=
