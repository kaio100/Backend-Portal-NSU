ENVIRONMENT=production
NFSE_AMBIENTE=producao
NFSE_VERIFY_SSL=true

# Use PostgreSQL gerenciado em producao. Nunca use SQLite compartilhado entre replicas.
DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/nfse

# STORAGE_BACKEND pode ser local somente com volume persistente e backup externo.
STORAGE_BACKEND=local
STORAGE_ROOT=/app/storage
STORAGE_BUCKET=nfse

# Gere valores reais no gerenciador de secrets do provedor.
SECRETS_KEY=
API_KEY=
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

WORKER_DRY_RUN=false
WORKER_TEMP_DIR=/app/data/tmp_worker
API_WORKER_ENABLED=false
EMBEDDED_SCHEDULER_ENABLED=false
PDF_STATUS_REVALIDATION_ENABLED=false

DANFSE_LIBRARY_ROOT=/app/backend/danfse
DANFSE_PHP_BINARY=php
DANFSE_XML_MAX_BYTES=5242880
DANFSE_TIMEOUT_SECONDS=60

# Informe somente os dominios publicos do frontend, separados por virgula.
CORS_ORIGINS=https://seu-frontend.exemplo.com
LOG_LEVEL=INFO
ALERT_WEBHOOK_URL=
