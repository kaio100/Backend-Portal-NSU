# ============================================================================
# MODELO de configuracao para container/producao. NAO COLOQUE VALORES REAIS
# AQUI: este arquivo e versionado no Git. Copie para .env.docker (ignorado)
# ou cadastre as variaveis direto no painel do Railway.
# ============================================================================

ENVIRONMENT="production"

# --- Banco -----------------------------------------------------------------
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres"

# --- Storage ---------------------------------------------------------------
# Em producao use "r2": o disco do container e efemero e os XML/PDF seriam
# perdidos a cada deploy. Somente o ambiente local usa "local".
STORAGE_BACKEND="r2"
R2_BUCKET_NAME="nfse-adn-prod"
R2_ACCOUNT_ID="SEU_ACCOUNT_ID"
R2_ENDPOINT_URL="https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="SUA_ACCESS_KEY"
R2_SECRET_ACCESS_KEY="SUA_SECRET_KEY"
R2_REGION="auto"
R2_PRESIGNED_EXPIRES_SECONDS="300"

# --- Chaves ----------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY="GERE_UMA_CHAVE_COM_NO_MINIMO_32_CARACTERES"
JWT_SECRET="GERE_UMA_CHAVE_COM_NO_MINIMO_32_CARACTERES"
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATENCAO: esta chave decifra as senhas dos certificados A1. Ao troca-la,
# todas as senhas de certificado precisam ser recadastradas.
SECRETS_KEY="GERE_UMA_CHAVE_FERNET"
JWT_EXPIRE_MINUTES="1440"

# --- ADN -------------------------------------------------------------------
NFSE_AMBIENTE="producao"
NFSE_VERIFY_SSL="true"
# NFS-e com emissao/competencia anterior a esta data sao descartadas.
NOTAS_DATA_CORTE="2026-01-01"

# --- Worker ----------------------------------------------------------------
WORKER_DRY_RUN="false"
WORKER_DRY_RUN_SLEEP="0.2"
WORKER_REAL_MAX_LIMITE="1000"
WORKER_REAL_MAX_PAUSA="0"
WORKER_CONSULTA_LOTE_TAMANHO="1000"
WORKER_ADN_LOTE="true"
WORKER_TEMP_DIR="data/tmp_worker"
API_WORKER_CONCURRENCY="1"
API_WORKER_SLEEP="0.2"
# Com worker e scheduler em processos separados (docker-compose), a API deve
# manter os dois desligados para nao duplicar consumidores da mesma fila.
API_WORKER_ENABLED="false"
EMBEDDED_SCHEDULER_ENABLED="false"

# --- Consultas -------------------------------------------------------------
CONSULTAS_SCHEDULER_SLEEP="1"
CONSULTAS_DEFAULT_LIMITE="1000"
CONSULTAS_DEFAULT_PAUSA="0"
NOTAS_RECEBIDAS_DIA_CORTE_MES_ANTERIOR="3"

# --- Integracoes -----------------------------------------------------------
CORS_ORIGINS="https://seu-frontend.vercel.app"
FRONTEND_BASE_URL="https://seu-frontend.vercel.app"
INVERTEXTO_ENABLED="false"
INVERTEXTO_TOKEN=""
INVERTEXTO_RPM="30"
INVERTEXTO_DELAY_SECONDS="0.6"
INVERTEXTO_CACHE_DAYS="30"
LOCAL_SIGNUP_ENABLED="false"
LOG_LEVEL="INFO"
ALERT_WEBHOOK_URL=""
